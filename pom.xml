<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>training.kotlin</groupId>
    <artifactId>kotlin-training</artifactId>
    <version>1.0.0-SNAPSHOT</version>

    <properties>
        <kotlin.version>2.1.0</kotlin.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-stdlib</artifactId>
            <version>${kotlin.version}</version>
        </dependency>
    </dependencies>

    <build>
        <sourceDirectory>${project.basedir}</sourceDirectory>
        <plugins>
            <plugin>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
                <version>${kotlin.version}</version>
                <executions>
                    <execution>
                        <id>compile</id>
                        <phase>compile</phase>
                        <goals><goal>compile</goal></goals>
                        <configuration>
                            <sourceDirs>
                                <sourceDir>${project.basedir}/Module0</sourceDir>
                                <sourceDir>${project.basedir}/Module1</sourceDir>
                                <sourceDir>${project.basedir}/Module2</sourceDir>
                                <sourceDir>${project.basedir}/Module3</sourceDir>
                                <sourceDir>${project.basedir}/Module4</sourceDir>
                                <sourceDir>${project.basedir}/Module5</sourceDir>
                                <sourceDir>${project.basedir}/Module6</sourceDir>
                                <sourceDir>${project.basedir}/Module7</sourceDir>
                                <sourceDir>${project.basedir}/Module8</sourceDir>
                                <sourceDir>${project.basedir}/Module9</sourceDir>
                            </sourceDirs>
                            <jvmTarget>21</jvmTarget>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>